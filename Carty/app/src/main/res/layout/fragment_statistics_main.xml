<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <Button
        android:id="@+id/statButton1"
        style="@style/Widget.Material3.Button"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:backgroundTint="#3F51B5"
        android:fontFamily="@font/pf_highway_sans_pro"
        android:text="Топ товаров по затратам"
        android:textSize="24sp"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="@+id/mainStatLable"
        app:layout_constraintStart_toStartOf="@+id/mainStatLable"
        app:layout_constraintTop_toBottomOf="@+id/mainStatLable" />

    <Button
        android:id="@+id/statButton2"
        style="@style/Widget.Material3.Button"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#3F51B5"
        android:fontFamily="@font/pf_highway_sans_pro"
        android:text="Среднемесячные покупки товара"
        android:textSize="24sp"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="@+id/statButton1"
        app:layout_constraintStart_toStartOf="@+id/statButton1"
        app:layout_constraintTop_toBottomOf="@+id/statButton1" />

    <Button
        android:id="@+id/statButton3"
        style="@style/Widget.Material3.Button"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#3F51B5"
        android:fontFamily="@font/pf_highway_sans_pro"
        android:text="Динамика общих трат"
        android:textSize="24sp"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="@+id/statButton1"
        app:layout_constraintStart_toStartOf="@+id/statButton1"
        app:layout_constraintTop_toBottomOf="@+id/statButton2" />

    <Button
        android:id="@+id/statButton4"
        style="@style/Widget.Material3.Button"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#3F51B5"
        android:fontFamily="@font/pf_highway_sans_pro"
        android:text="Распределение трат по отделам"
        android:textSize="24sp"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="@+id/statButton1"
        app:layout_constraintStart_toStartOf="@+id/statButton1"
        app:layout_constraintTop_toBottomOf="@+id/statButton3" />

    <TextView
        android:id="@+id/mainStatLable"
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp"
        android:fontFamily="@font/uncage"
        android:lineSpacingExtra="4dp"
        android:text="Статистика\nпокупок"
        android:textAlignment="center"
        android:textColor="#3F50B4"
        android:textSize="48sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>