<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/stat1Lable"
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/uncage"
        android:lineSpacingExtra="4dp"
        android:text="Топ товаров по затратам"
        android:textAlignment="center"
        android:textColor="#3F50B4"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/stat1Spinner"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/pf_highway_sans_pro"
        android:minHeight="42dp"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="@+id/stat1Lable"
        app:layout_constraintStart_toStartOf="@+id/stat1Lable"
        app:layout_constraintTop_toBottomOf="@+id/stat1Lable" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stat1RV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stat1Spinner"
        tools:listitem="@layout/item_statistic_top_product" />
</androidx.constraintlayout.widget.ConstraintLayout>