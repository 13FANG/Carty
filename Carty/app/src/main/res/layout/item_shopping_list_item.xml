<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp"
    app:strokeColor="#00FFFFFF"
    app:strokeWidth="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00D9FF"
        android:padding="16dp"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/itemNameTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pf_highway_sans_pro"
            android:text="Название товара"
            android:textColor="#FFFF"
            android:textColorHint="#000000"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/imageButton"
            app:layout_constraintStart_toEndOf="@+id/itemBoughtCB"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/itemDepartmentNameTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pf_highway_sans_pro"
            android:textColor="#FFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/itemNameTV"
            app:layout_constraintStart_toStartOf="@+id/itemNameTV"
            app:layout_constraintTop_toBottomOf="@+id/itemNameTV"
            tools:text="Молочный отдел"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/itemQuantityTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pf_highway_sans_pro"
            android:text="Количество и ед. изм."
            android:textColor="#FFFF"
            android:textColorHint="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/itemNameTV"
            app:layout_constraintStart_toStartOf="@+id/itemNameTV"
            app:layout_constraintTop_toBottomOf="@+id/itemDepartmentNameTV" />

        <TextView
            android:id="@+id/itemQuantityUnitTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pf_highway_sans_pro"
            android:text="1549р. за ед. изм."
            android:textColor="#FFFF"
            android:textColorHint="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/itemNameTV"
            app:layout_constraintStart_toStartOf="@+id/itemNameTV"
            app:layout_constraintTop_toBottomOf="@+id/itemQuantityTV" />

        <CheckBox
            android:id="@+id/itemBoughtCB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:buttonTint="#0D47A1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/binicon"
            app:tint="#FFFF" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>