<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Carty" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Carty" parent="Base.Theme.Carty">
        <item name="materialAlertDialogTheme">@style/MyMaterialAlertDialogTheme</item>
    </style>

    <style name="MyMaterialAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/MyDialogShapeAppearanceOverlay</item>
    </style>

    <style name="MyDialogShapeAppearanceOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="MyPopupMenu.White" parent="ThemeOverlay.Material3.Light">
        <item name="android:background">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
    </style>
</resources>